# Copy to .env.local and fill from InsForge dashboard / CLI.
# Never commit real keys. Get anon key: npx -y @insforge/cli secrets get ANON_KEY

# Client (Vite / TanStack Start browser)
VITE_INSFORGE_URL=https://your-appkey.region.insforge.app
VITE_INSFORGE_ANON_KEY=your-anon-key

# Server (API routes / privileged — do not expose API_KEY to the browser)
INSFORGE_URL=https://your-appkey.region.insforge.app
INSFORGE_ANON_KEY=your-anon-key
# INSFORGE_API_KEY=ik_your_admin_api_key_server_only
